{
  "name": "ui-kit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && size-limit",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc -b && knip && vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "e2e": "node e2e/run.mjs",
    "e2e:smoke": "node e2e/gallery-smoke.mjs",
    "e2e:a11y": "node e2e/a11y.mjs",
    "test": "vitest run",
    "knip": "knip",
    "size": "size-limit"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@formkit/auto-animate": "^0.10.2",
    "@tanstack/react-virtual": "^3.14.26",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@huyab/config": "github:nguyenhuy158/kit#v0.4.0&path:packages/config",
    "@huyab/e2e": "github:nguyenhuy158/kit#v0.4.0&path:packages/e2e",
    "@size-limit/file": "^14.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "4.10.2",
    "jsdom": "^31.0.1",
    "knip": "^6.46.1",
    "lefthook": "^2.2.2",
    "playwright-core": "^1.63.0",
    "size-limit": "^14.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.7.0",
    "vite": "^7.3.8",
    "vitest": "^5.1.1"
  },
  "size-limit": [
    {
      "name": "gallery JS (gzip)",
      "path": "dist/assets/*.js",
      "gzip": true,
      "limit": "160 kB"
    }
  ]
}
